<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/quick_template_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Search templates" />

    <Spinner
        android:id="@+id/quick_template_category"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/quick_template_recycler"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btn_manage_templates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Manage templates" />

</LinearLayout>
